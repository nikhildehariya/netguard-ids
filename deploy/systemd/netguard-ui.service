[Unit]
Description=NetGuard IDS Frontend Dashboard Server
After=network.target netguard-api.service

[Service]
Type=simple
User=netguard
Group=netguard
WorkingDirectory=/opt/netguard/react-dashboard
ExecStart=/usr/bin/npm run preview -- --host 0.0.0.0 --port 5174
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
