# ==============================================================================
# NetGuard IDS — Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in your credentials.
# ==============================================================================

# ── Email Alert Notifications ──────────────────────────────────────────────────
ALERT_FROM_EMAIL=your-email@gmail.com
ALERT_TO_EMAIL=your-alert-recipient@gmail.com
ALERT_PASSWORD=your-app-password-or-smtp-key

# ── Admin Authentication & JWT Security ───────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=netguard123
SECRET_KEY=change-this-to-a-secure-random-64-char-hex-string

# ── Automated Active Response & Firewall Quarantine ───────────────────────────
AUTO_BLOCK_ENABLED=false
AUTO_BLOCK_THRESHOLD=3
AUTO_BLOCK_CONFIDENCE=0.98
AUTO_BLOCK_SEVERITIES=critical
AUTO_BLOCK_TTL=3600
WHITELISTED_IPS=8.8.8.8,1.1.1.1

# ── Telegram Real-Time Threat Alerts (Optional) ───────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── Agent Fleet & Licensing ───────────────────────────────────────────────────
AGENT_SECRET_KEY=change-this-to-a-secure-random-64-char-hex-string
API_PORT=8080
LICENSE_KEY=NETGUARD-DEV-MASTER-999

# ── AI Copilot / Generative Security Intelligence (Optional) ───────────────────
HF_TOKEN=your-huggingface-api-token
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
GEMINI_API_KEY=your-gemini-api-key

# ── Database Engine (PostgreSQL / NeonDB or SQLite Local Fallback) ─────────────
# Note: If DATABASE_URL is left blank, NetGuard will automatically default to local SQLite (detections.db)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_SSLMODE=require
