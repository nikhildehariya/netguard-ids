# Production Multi-Stage Dockerfile for NetGuard Frontend (Vite + Nginx)

# --- Stage 1: Build Vite React App ---
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies using clean install
COPY react-dashboard/package*.json ./
RUN npm ci

# Copy React frontend source code and build production assets
COPY react-dashboard/ ./
RUN npm run build

# --- Stage 2: Serve via Production Nginx ---
FROM nginx:alpine

# Copy compiled static assets to Nginx default document root
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration for SPA routing and API reverse proxying
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
